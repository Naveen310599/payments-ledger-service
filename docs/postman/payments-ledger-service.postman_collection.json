{
  "info": {
    "name": "payments-ledger-service",
    "description": "Requests and checks for the payments-ledger-service API.\n\nStart the app (run LedgerApplication), then use Run collection. Run the folders in order: \"Create account\" saves the new id into the accountId variable that \"Get account\" and \"Deposit\" use.\n\nChange baseUrl under the collection's Variables tab if the app is not on localhost:8080.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "accountId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"returns 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"service is UP\", () => pm.expect(pm.response.json().status).to.eql(\"UP\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/health"
          }
        }
      ]
    },
    {
      "name": "Accounts",
      "item": [
        {
          "name": "Create account",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"returns 201 Created\", () => pm.response.to.have.status(201));",
                  "",
                  "const account = pm.response.json();",
                  "",
                  "pm.test(\"Location header points at the new account\", () => {",
                  "    pm.expect(pm.response.headers.get(\"Location\")).to.match(new RegExp(\"/api/accounts/\" + account.id + \"$\"));",
                  "});",
                  "",
                  "pm.test(\"new account starts at 0.00\", () => {",
                  "    // Checked on the raw text: pm.response.json() would turn 0.00 into 0 and hide the decimal places",
                  "    pm.expect(pm.response.text()).to.include('\"balance\":0.00');",
                  "});",
                  "",
                  "// Used by the \"Get account\" request",
                  "pm.collectionVariables.set(\"accountId\", account.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ownerName\": \"Alice\",\n  \"currency\": \"INR\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/accounts"
          }
        },
        {
          "name": "Get account",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"returns 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"returns the account created earlier\", () => {",
                  "    pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get(\"accountId\"));",
                  "    pm.expect(pm.response.json().currency).to.eql(\"INR\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/accounts/{{accountId}}",
            "description": "Run \"Create account\" first: it stores the new id in the accountId collection variable."
          }
        },
        {
          "name": "Deposit",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"returns 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"balance went from 0.00 to 500.00\", () => {",
                  "    // Raw text again, so a balance of 500 (lost decimal places) would fail",
                  "    pm.expect(pm.response.text()).to.include('\"balance\":500.00');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 500.00\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/accounts/{{accountId}}/deposits",
            "description": "Run \"Create account\" first. Sending this again adds another 500.00, so the balance check only passes on a fresh account."
          }
        }
      ]
    },
    {
      "name": "Accounts - errors",
      "description": "Every error from this API is RFC 9457 problem+json. The folder-level test checks that for each request below.",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"error body is problem+json\", () => {",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\");",
              "});"
            ]
          }
        }
      ],
      "item": [
        {
          "name": "Create account - blank owner name",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"returns 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"names the ownerName field\", () => pm.expect(pm.response.json().errors).to.have.property(\"ownerName\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ownerName\": \"   \",\n  \"currency\": \"INR\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/accounts"
          }
        },
        {
          "name": "Create account - unknown currency",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"returns 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"names the currency field\", () => pm.expect(pm.response.json().errors).to.have.property(\"currency\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ownerName\": \"Alice\",\n  \"currency\": \"ABC\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/accounts",
            "description": "ABC has the right shape (3 capital letters) but is not a real ISO 4217 currency."
          }
        },
        {
          "name": "Create account - missing currency",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"returns 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"names the currency field\", () => pm.expect(pm.response.json().errors).to.have.property(\"currency\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ownerName\": \"Alice\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/accounts"
          }
        },
        {
          "name": "Create account - malformed JSON",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"returns 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"ownerName\": ",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/accounts"
          }
        },
        {
          "name": "Get account - unknown id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"returns 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"title says which resource is missing\", () => pm.expect(pm.response.json().title).to.eql(\"Account not found\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/accounts/{{$guid}}",
            "description": "{{$guid}} is a Postman built-in that generates a fresh random UUID on every send."
          }
        },
        {
          "name": "Get account - id is not a UUID",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"returns 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/accounts/not-a-uuid"
          }
        },
        {
          "name": "Deposit - zero amount",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"returns 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"names the amount field\", () => pm.expect(pm.response.json().errors).to.have.property(\"amount\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/accounts/{{$guid}}/deposits",
            "description": "The body is validated before the account is looked up, so any id gives 400 here."
          }
        },
        {
          "name": "Deposit - negative amount",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"returns 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"names the amount field\", () => pm.expect(pm.response.json().errors).to.have.property(\"amount\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": -10.00\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/accounts/{{$guid}}/deposits",
            "description": "The body is validated before the account is looked up, so any id gives 400 here."
          }
        },
        {
          "name": "Deposit - three decimal places",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"returns 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"names the amount field\", () => pm.expect(pm.response.json().errors).to.have.property(\"amount\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 10.001\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/accounts/{{$guid}}/deposits",
            "description": "Money has at most 2 decimal places, so 10.001 is rejected."
          }
        },
        {
          "name": "Deposit - unknown account",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"returns 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"title says which resource is missing\", () => pm.expect(pm.response.json().title).to.eql(\"Account not found\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 10.00\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/accounts/{{$guid}}/deposits"
          }
        }
      ]
    }
  ]
}
